# Copy to .env in the repository root and fill the credential locally.
# scripts/run_task7.py reads this file; never commit the .env file.
DEEPSEEK_API_KEY=
# Current official model ID; legacy aliases are not a pinned model version.
ESG_EXTRACTION_MODEL=deepseek-flash
DSH_MODEL=deepseek-flash
ESG_EXTRACTION_TIMEOUT=100
ESG_EXTRACTION_MAX_TOKENS=16384
ESG_DATABASE_PATH=./data/esg.sqlite3
ESG_HARNESS_ENABLED=1
# Prepare these separate paths with scripts/prepare_harness.py first.
ESG_DSH_HOME=./data/harness/home
ESG_WORKSPACE=./data/harness/workspace
ESG_HARNESS_PATCH=./data/harness/home/esg-tools.patch.yml
ESG_API_BASE_URL=http://127.0.0.1:8000
